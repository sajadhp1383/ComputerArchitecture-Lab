module control_unit (
    input [1:0] Mode,
    input [3:0] OpCode,
    input S,
    output reg [3:0] EXE_CMD,
    output reg MEM_R_EN,
    output reg MEM_W_EN,
    output reg WB_EN,
    output reg Imm,
    output reg B,
    output reg S_update
);

    
    localparam
        CMD_MOV = 4'b0001,
        CMD_MVN = 4'b1001,
        CMD_ADD = 4'b0010,
        CMD_ADC = 4'b0011,
        CMD_SUB = 4'b0100,
        CMD_SBC = 4'b0101,
        CMD_AND = 4'b0110,
        CMD_ORR = 4'b0111,
        CMD_EOR = 4'b1000,
        CMD_NOP = 4'b0000;

    always @(*) begin
        
        EXE_CMD   = CMD_NOP;
        MEM_R_EN  = 1'b0;
        MEM_W_EN  = 1'b0;
        WB_EN     = 1'b0;
        Imm       = 1'b0;
        B         = 1'b0;
        S_update  = 1'b0;

        case (Mode)
            2'b00: begin 
                if (OpCode == 4'b1101) begin // MOV
                    EXE_CMD = CMD_MOV;
                    WB_EN   = 1'b1;
                    Imm     = 1'b1;
                end
                else if (OpCode == 4'b1111) begin // MVN
                    EXE_CMD = CMD_MVN;
                    WB_EN   = 1'b1;
                    Imm     = 1'b1;
                end
                else if (OpCode == 4'b0100) begin // ADD
                    EXE_CMD = CMD_ADD;
                    WB_EN   = 1'b1;
                    Imm     = 1'b0;
                    S_update = S;
                end
                else if (OpCode == 4'b0101) begin // ADC
                    EXE_CMD = CMD_ADC;
                    WB_EN   = 1'b1;
                    Imm     = 1'b0;
                    S_update = S;
                end
                else if (OpCode == 4'b0010) begin // SUB
                    EXE_CMD = CMD_SUB;
                    WB_EN   = 1'b1;
                    Imm     = 1'b0;
                    S_update = S;
                end
                else if (OpCode == 4'b0110) begin // SBC
                    EXE_CMD = CMD_SBC;
                    WB_EN   = 1'b1;
                    Imm     = 1'b0;
                    S_update = S;
                end
                else if (OpCode == 4'b0000) begin // AND
                    EXE_CMD = CMD_AND;
                    WB_EN   = 1'b1;
                    Imm     = 1'b0;
                    S_update = S;
                end
                else if (OpCode == 4'b1100) begin // ORR
                    EXE_CMD = CMD_ORR;
                    WB_EN   = 1'b1;
                    Imm     = 1'b0;
                    S_update = S;
                end
                else if (OpCode == 4'b0001) begin // EOR
                    EXE_CMD = CMD_EOR;
                    WB_EN   = 1'b1;
                    Imm     = 1'b0;
                    S_update = S;
                end
                else if (OpCode == 4'b1010) begin // CMP
                    EXE_CMD  = CMD_SUB;
                    WB_EN    = 1'b0;
                    Imm      = 1'b0;
                    S_update = 1'b1;
                end
                else if (OpCode == 4'b1000) begin // TST
                    EXE_CMD  = CMD_AND;
                    WB_EN    = 1'b0;
                    Imm      = 1'b0;
                    S_update = 1'b1;
                end
            end

            2'b01: begin 
                EXE_CMD = CMD_ADD;  
                if (S == 1'b1) begin // LDR
                    MEM_R_EN = 1'b1;
                    WB_EN    = 1'b1;
                    Imm      = 1'b1;
                end else begin // STR
                    MEM_W_EN = 1'b1;
                    WB_EN    = 1'b0;
                    Imm      = 1'b1;
                end
            end

            2'b10: begin 
                B = 1'b1;
            end

            default: ;
        endcase
    end

endmodule